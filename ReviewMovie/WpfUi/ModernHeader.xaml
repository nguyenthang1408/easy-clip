<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#F4F7FB"
             d:DesignHeight="180" d:DesignWidth="860">
  <UserControl.Resources>
    <SolidColorBrush x:Key="CardBg" Color="White" />
    <SolidColorBrush x:Key="TextMuted" Color="#6B7280" />
    <SolidColorBrush x:Key="Accent" Color="#F97316" />
    <SolidColorBrush x:Key="Border" Color="#E5E7EB" />

    <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="2" Opacity="0.15" />

    <Style x:Key="CardStyle" TargetType="{x:Type Border}">
      <Setter Property="Background" Value="{StaticResource CardBg}" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource Border}" />
      <Setter Property="Effect" Value="{StaticResource CardShadow}" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="8,8,8,8" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="10"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="#F3F4F6" />
      <Setter Property="Foreground" Value="#111827" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="10"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FlatLinkButton" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#111827" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="8"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ModernTextBox" TargetType="{x:Type TextBox}">
      <Setter Property="BorderBrush" Value="{StaticResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="#FBFDFF" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TextBox}">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="12"
                    SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.1*" MinWidth="200" />
      <ColumnDefinition Width="3.0*" MinWidth="420" />
      <ColumnDefinition Width="1.6*" MinWidth="260" />
    </Grid.ColumnDefinitions>

    <!-- Record -->
    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Border Width="72" Height="72" Background="#F3F4F6" CornerRadius="36" BorderThickness="1" BorderBrush="{StaticResource Border}">
            <TextBlock Text="🎙" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
          <TextBlock Margin="0,10,0,2" Text="Record" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="Click to start mic" Foreground="{StaticResource TextMuted}" FontSize="12" HorizontalAlignment="Center" />
        </StackPanel>

        <Button x:Name="BtnStartRecord"
                Grid.Row="1"
                Margin="0,12,0,0"
                Style="{StaticResource PrimaryButton}"
                Content="Start" />
      </Grid>
    </Border>

    <!-- Text input -->
    <Border Grid.Column="1" Style="{StaticResource CardStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock Text="TEXT INPUT"
                     FontSize="12"
                     FontWeight="Bold"
                     Foreground="#374151"
                     VerticalAlignment="Center" />

          <Button x:Name="BtnClearText"
                  Grid.Column="1"
                  Style="{StaticResource FlatLinkButton}"
                  Content="Clear" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,10,0,0">
          <TextBox x:Name="TxtInput"
                   Style="{StaticResource ModernTextBox}" />
          <TextBlock x:Name="TxtPlaceholder"
                     Text="Type text to synthesize or drag audio files here..."
                     Foreground="#9CA3AF"
                     Margin="14,12,14,12"
                     IsHitTestVisible="False"
                     TextWrapping="Wrap" />
        </Grid>
      </Grid>
    </Border>

    <!-- Visuals -->
    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="VISUALS"
                   FontSize="12"
                   FontWeight="Bold"
                   Foreground="#374151"
                   VerticalAlignment="Center" />

        <Border Grid.Row="1"
                Margin="0,10,0,10"
                CornerRadius="12"
                BorderThickness="2"
                Background="#F8FAFC">
          <Border.BorderBrush>
            <SolidColorBrush Color="#CBD5E1" />
          </Border.BorderBrush>
          <Grid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="🖼" FontSize="22" HorizontalAlignment="Center" />
              <TextBlock Margin="0,8,0,2" Text="Drop Visuals Here" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="Images or Videos" Foreground="{StaticResource TextMuted}" FontSize="12" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Button x:Name="BtnConvert" Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource GhostButton}" Content="Convert" />
          <Button x:Name="BtnSave" Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource GhostButton}" Content="Save" />
          <Button x:Name="BtnRender" Grid.Column="2" Style="{StaticResource GhostButton}" Content="Render" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>

