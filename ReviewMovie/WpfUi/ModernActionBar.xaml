<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent"
             d:DesignHeight="48" d:DesignWidth="900">
  <UserControl.Resources>
    <SolidColorBrush x:Key="Border" Color="#E5E7EB" />
    <SolidColorBrush x:Key="Text" Color="#111827" />
    <SolidColorBrush x:Key="Muted" Color="#6B7280" />
    <SolidColorBrush x:Key="Orange" Color="#F97316" />
    <SolidColorBrush x:Key="Red" Color="#EF4444" />

    <Style x:Key="PillButtonBase" TargetType="{x:Type Button}">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource Border}" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="{StaticResource Text}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F9FAFB"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#F3F4F6"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryPill" TargetType="{x:Type Button}" BasedOn="{StaticResource PillButtonBase}">
      <Setter Property="Background" Value="{StaticResource Orange}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="White" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#FB923C"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#F97316"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="DangerIconCircle" TargetType="{x:Type Border}">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="#FEE2E2" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="OkIconCircle" TargetType="{x:Type Border}">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="#FFEDD5" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="0,6,0,6">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <TextBlock Text="Chọn tác vụ"
               VerticalAlignment="Center"
               Foreground="{StaticResource Muted}"
               FontWeight="SemiBold"
               Margin="8,0,12,0"/>

    <Button x:Name="BtnNewLine" Grid.Column="1" Margin="0,0,10,0" Style="{StaticResource PrimaryPill}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Style="{StaticResource OkIconCircle}" Background="#FDBA74">
          <TextBlock Text="+" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="New Line" VerticalAlignment="Center"/>
      </StackPanel>
    </Button>

    <Button x:Name="BtnAutoSubtitle" Grid.Column="2" Margin="0,0,10,0" Style="{StaticResource PillButtonBase}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Style="{StaticResource OkIconCircle}">
          <TextBlock Text="✦" Foreground="{StaticResource Orange}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="Auto Subtitle" VerticalAlignment="Center"/>
      </StackPanel>
    </Button>

    <Button x:Name="BtnCancel" Grid.Column="3" HorizontalAlignment="Left" Style="{StaticResource PillButtonBase}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Style="{StaticResource DangerIconCircle}">
          <TextBlock Text="✕" Foreground="{StaticResource Red}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="Cancel" VerticalAlignment="Center"/>
      </StackPanel>
    </Button>
  </Grid>
</UserControl>

