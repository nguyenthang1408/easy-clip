<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wf="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
      Background="#F3F4F6">
  <Grid.RowDefinitions>
    <!-- Top header -->
    <RowDefinition Height="72" />
    <!-- Content -->
    <RowDefinition Height="*" />
  </Grid.RowDefinitions>
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="420" />
  </Grid.ColumnDefinitions>

  <!-- Top header bar (used as window title bar) -->
  <Border x:Name="TopHeader" Grid.Row="0" Grid.ColumnSpan="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
    <Grid Margin="18,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Left: logo + app name -->
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="40" Height="40" CornerRadius="10" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1">
          <TextBlock Text="EC" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#F97316"/>
        </Border>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="EasyClip Studio" FontWeight="Bold" FontSize="14" Foreground="#111827" />
          <TextBlock Text="TPMEDIA PREMIUM" FontSize="10.5" Foreground="#6B7280" Margin="0,2,0,0"/>
        </StackPanel>
      </StackPanel>

      <!-- Right: status + remaining + icons + avatar -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Border x:Name="BadgeStatus"
                Background="#DCFCE7"
                BorderBrush="#BBF7D0"
                BorderThickness="1"
                CornerRadius="12"
                Height="26"
                Padding="10,0"
                VerticalAlignment="Center"
                Margin="0,0,10,0">
          <Grid>
            <TextBlock x:Name="TxtStatus"
                       Text="Active"
                       Foreground="#16A34A"
                       FontWeight="Bold"
                       FontSize="11.5"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
          </Grid>
        </Border>

        <TextBlock x:Name="TxtRemaining"
                   Text="1 Day Remaining"
                   Foreground="#374151"
                   FontSize="11.5"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0"/>

        <Border Width="1" Height="22" Background="#E5E7EB" Margin="0,0,12,0"/>

        <Button x:Name="BtnHelp" Width="32" Height="32" Background="#F3F4F6" BorderBrush="#E5E7EB" Margin="0,0,8,0">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE897;" Foreground="#6B7280" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>

        <Button x:Name="BtnSettings" Width="32" Height="32" Background="#F3F4F6" BorderBrush="#E5E7EB" Margin="0,0,12,0">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Foreground="#6B7280" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>

        <Border x:Name="Avatar" Width="32" Height="32" CornerRadius="16" Background="#F97316" BorderBrush="#FB923C" BorderThickness="1">
          <TextBlock x:Name="TxtAvatar" Text="TN" Foreground="White" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- Window buttons -->
        <Border Width="1" Height="22" Background="#E5E7EB" Margin="12,0,12,0"/>
        <Button x:Name="BtnMinimize" Width="32" Height="32" Background="Transparent" BorderBrush="#E5E7EB">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE921;" Foreground="#6B7280" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
        <Button x:Name="BtnClose" Width="32" Height="32" Background="Transparent" BorderBrush="#E5E7EB" Margin="8,0,0,0">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8BB;" Foreground="#6B7280" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
      </StackPanel>
    </Grid>
  </Border>

  <!-- Main -->
  <Grid Grid.Row="1" Grid.Column="0" Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Top cards row -->
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="260" />
      </Grid.ColumnDefinitions>

      <!-- Record card -->
      <Border Grid.Column="0" Background="White" CornerRadius="14" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12" Margin="0,0,10,0">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <Border Width="60" Height="60" CornerRadius="30" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1">
            <TextBlock Text="🎤" FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>
          <TextBlock Text="Record" FontWeight="SemiBold" Foreground="#111827" Margin="0,10,0,0" HorizontalAlignment="Center"/>
          <TextBlock Text="Click to start mic" Foreground="#6B7280" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/>
          <Button x:Name="BtnRecord" Content="Start" Margin="0,10,0,0" Padding="14,6"
                  Background="#FFFFFF" BorderBrush="#E5E7EB" Foreground="#111827" />
        </StackPanel>
      </Border>

      <!-- Text input card -->
      <Border Grid.Column="1" Background="White" CornerRadius="14" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12" Margin="0,0,10,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0" LastChildFill="False">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="≡" Foreground="#94A3B8" Margin="0,0,6,0"/>
              <TextBlock Text="TEXT INPUT" FontWeight="SemiBold" Foreground="#6B7280" />
            </StackPanel>
            <Button x:Name="BtnClearText" Content="Clear" DockPanel.Dock="Right" Padding="10,4" Background="#F3F4F6" BorderBrush="#E5E7EB" />
          </DockPanel>

          <Border Grid.Row="1"
                  CornerRadius="12"
                  BorderBrush="#E5E7EB"
                  BorderThickness="1"
                  Background="White"
                  Margin="0,10,0,0"
                  Padding="10"
                  MinHeight="100">
            <Grid>
              <TextBox x:Name="TextInputBox"
                       Background="Transparent"
                       BorderThickness="0"
                       Foreground="#111827"
                       FontSize="12"
                       TextWrapping="Wrap"
                       AcceptsReturn="True"
                       VerticalScrollBarVisibility="Auto"
                       AllowDrop="True" />
              <TextBlock x:Name="TextInputPlaceholder"
                         Text="Type text to synthesize or drag audio files here..."
                         Foreground="#94A3B8"
                         Margin="2,2,2,2"
                         IsHitTestVisible="False"/>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- Drop visuals card -->
      <Border Grid.Column="2" Background="White" CornerRadius="14" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="VISUALS" FontWeight="SemiBold" Foreground="#6B7280" />
          <Grid Grid.Row="1" Margin="0,10,0,10" AllowDrop="True" x:Name="VisualDropZone">
            <Rectangle RadiusX="12" RadiusY="12" Fill="#EEF2F7" Stroke="#CBD5E1" StrokeThickness="1" StrokeDashArray="4 3"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="🖼️" FontSize="22" HorizontalAlignment="Center" Foreground="#64748B"/>
              <TextBlock Text="Drop Visuals Here" FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="#111827"/>
              <TextBlock Text="Images or Videos" Foreground="#6B7280" FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>

          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnConvert" Content="Convert" Padding="12,6" Background="White" BorderBrush="#E5E7EB" Margin="0,0,8,0"/>
            <Button x:Name="BtnSave" Content="Save" Padding="12,6" Background="White" BorderBrush="#E5E7EB" Margin="0,0,8,0"/>
            <Button x:Name="BtnRender" Content="Render" Padding="12,6" Background="White" BorderBrush="#E5E7EB"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Toolbar row (host WinForms ToolStrip to keep all items) -->
    <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="6" Margin="0,0,0,10">
      <wf:WindowsFormsHost x:Name="ToolbarHost" />
    </Border>

    <!-- Table (host WinForms DataGridView) -->
    <Border Grid.Row="2" Background="White" CornerRadius="14" BorderBrush="#E5E7EB" BorderThickness="1">
      <wf:WindowsFormsHost x:Name="MainGridHost" Margin="0" />
    </Border>
  </Grid>

  <!-- Right sidebar (host WinForms settings to keep all items + logic) -->
  <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14" Margin="0,14,14,14" Padding="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="Settings" FontWeight="Bold" Foreground="#111827" Margin="4,2,0,10"/>

      <!-- IMPORTANT: Do NOT wrap WindowsFormsHost in WPF ScrollViewer (airspace issues).
           We use WinForms AutoScroll panel instead (see FormMain). -->
      <wf:WindowsFormsHost Grid.Row="1" x:Name="SettingsHost" />
    </Grid>
  </Border>
</Grid>

