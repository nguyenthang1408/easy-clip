<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wf="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
      Background="#F3F4F6">
  <Grid.RowDefinitions>
    <!-- Top header -->
    <RowDefinition Height="72" />
    <!-- Content -->
    <RowDefinition Height="*" />
  </Grid.RowDefinitions>
  <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" />
    <ColumnDefinition Width="420" />
  </Grid.ColumnDefinitions>

  <!-- Top header bar (match screenshot) -->
  <Border Grid.Row="0" Grid.ColumnSpan="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
    <Grid Margin="18,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="40" Height="40" CornerRadius="10" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1">
          <TextBlock Text="🎬" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="EasyClip Studio" FontWeight="Bold" FontSize="14" Foreground="#111827" />
          <TextBlock Text="TPMEDIA PREMIUM" FontSize="10.5" Foreground="#6B7280" Margin="0,2,0,0"/>
        </StackPanel>
      </StackPanel>

      <!-- Right side placeholder (kept minimal like screenshot crop) -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="34" Height="34" CornerRadius="10" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1">
          <TextBlock Text="≡" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#6B7280"/>
        </Border>
      </StackPanel>
    </Grid>
  </Border>

  <!-- Main -->
  <Grid Grid.Row="1" Grid.Column="0" Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Top cards row -->
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="260" />
      </Grid.ColumnDefinitions>

      <!-- Record card -->
      <Border Grid.Column="0" Background="White" CornerRadius="14" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12" Margin="0,0,10,0">
        <wf:WindowsFormsHost x:Name="RecordHost" />
      </Border>

      <!-- Text input card -->
      <Border Grid.Column="1" Background="White" CornerRadius="14" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12" Margin="0,0,10,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock Text="TEXT INPUT" FontWeight="SemiBold" Foreground="#6B7280" />
            <Button x:Name="BtnClearText" Content="Clear" DockPanel.Dock="Right" Padding="10,4" Background="#F3F4F6" BorderBrush="#E5E7EB" />
          </DockPanel>

          <Border Grid.Row="1"
                  CornerRadius="12"
                  BorderBrush="#E5E7EB"
                  BorderThickness="1"
                  Background="White"
                  Margin="0,10,0,0"
                  Padding="6"
                  MinHeight="140">
            <wf:WindowsFormsHost x:Name="TextInputHost" />
          </Border>
        </Grid>
      </Border>

      <!-- Drop visuals card -->
      <Border Grid.Column="2" Background="White" CornerRadius="14" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="VISUALS" FontWeight="SemiBold" Foreground="#6B7280" />
          <Border Grid.Row="1" Margin="0,10,0,0" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Background="#F9FAFB" Padding="6">
            <wf:WindowsFormsHost x:Name="VisualsHost" />
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- Toolbar row (host WinForms ToolStrip to keep all items) -->
    <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="6" Margin="0,0,0,10">
      <wf:WindowsFormsHost x:Name="ToolbarHost" />
    </Border>

    <!-- Table (host WinForms DataGridView) -->
    <Border Grid.Row="2" Background="White" CornerRadius="14" BorderBrush="#E5E7EB" BorderThickness="1">
      <wf:WindowsFormsHost x:Name="MainGridHost" Margin="0" />
    </Border>
  </Grid>

  <!-- Right sidebar (host WinForms settings to keep all items + logic) -->
  <Border Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="14" Margin="0,14,14,14" Padding="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="Settings" FontWeight="Bold" Foreground="#111827" Margin="4,2,0,10"/>

      <!-- IMPORTANT: Do NOT wrap WindowsFormsHost in WPF ScrollViewer (airspace issues).
           We use WinForms AutoScroll panel instead (see FormMain). -->
      <wf:WindowsFormsHost Grid.Row="1" x:Name="SettingsHost" />
    </Grid>
  </Border>
</Grid>

