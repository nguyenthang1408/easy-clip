<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F3F4F6">
  <Grid.Resources>
    <Style x:Key="BtnPrimary" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#F97316"/>
      <Setter Property="BorderBrush" Value="#F97316"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#FB923C"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#FB923C"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#EA580C"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#EA580C"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BtnSecondary" TargetType="{x:Type Button}">
      <Setter Property="Foreground" Value="#111827"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#E5E7EB"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BtnPill" TargetType="{x:Type Button}" BasedOn="{StaticResource BtnSecondary}">
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="999">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#E5E7EB"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <Grid Margin="0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="180" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="260" />
    </Grid.ColumnDefinitions>

    <!-- Record card -->
    <Border Grid.Column="0" Background="White" CornerRadius="14" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12" Margin="0,0,10,0">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Width="60" Height="60" CornerRadius="30" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1">
          <TextBlock Text="🎤" FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
        <TextBlock Text="Record" FontWeight="SemiBold" Foreground="#111827" Margin="0,10,0,0" HorizontalAlignment="Center"/>
        <TextBlock Text="Click to start mic" Foreground="#6B7280" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"/>
        <Button x:Name="BtnRecord" Content="Start" Margin="0,10,0,0" Style="{StaticResource BtnPrimary}"/>
      </StackPanel>
    </Border>

    <!-- Text input card -->
    <Border Grid.Column="1" Background="White" CornerRadius="14" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12" Margin="0,0,10,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="≡" Foreground="#94A3B8" Margin="0,0,6,0"/>
            <TextBlock Text="TEXT INPUT" FontWeight="SemiBold" Foreground="#6B7280" />
          </StackPanel>
          <Button x:Name="BtnClearText" Content="Clear" DockPanel.Dock="Right" Style="{StaticResource BtnPill}" />
        </DockPanel>

        <Border Grid.Row="1"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Background="White"
                Margin="0,10,0,0"
                Padding="10"
                MinHeight="100">
          <Grid>
            <TextBox x:Name="TextInputBox"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="#111827"
                     FontSize="12"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     AllowDrop="True" />
            <TextBlock x:Name="TextInputPlaceholder"
                       Text="Type text to synthesize or drag audio files here..."
                       Foreground="#94A3B8"
                       Margin="2,2,2,2"
                       IsHitTestVisible="False"/>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <!-- Visuals card -->
    <Border Grid.Column="2" Background="White" CornerRadius="14" BorderBrush="#E5E7EB" BorderThickness="1" Padding="12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="VISUALS" FontWeight="SemiBold" Foreground="#6B7280" />
        <Grid Grid.Row="1" Margin="0,10,0,10" AllowDrop="True" x:Name="VisualDropZone">
          <Rectangle RadiusX="12" RadiusY="12" Fill="#EEF2F7" Stroke="#CBD5E1" StrokeThickness="1" StrokeDashArray="4 3"/>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="🖼️" FontSize="22" HorizontalAlignment="Center" Foreground="#64748B"/>
            <TextBlock Text="Drop Visuals Here" FontWeight="SemiBold" Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="#111827"/>
            <TextBlock Text="Images or Videos" Foreground="#6B7280" FontSize="11" HorizontalAlignment="Center"/>
          </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="BtnConvert" Content="Convert" Margin="0,0,8,0" Style="{StaticResource BtnSecondary}"/>
          <Button x:Name="BtnSave" Content="Save" Margin="0,0,8,0" Style="{StaticResource BtnSecondary}"/>
          <Button x:Name="BtnRender" Content="Render" Style="{StaticResource BtnSecondary}"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Grid>

